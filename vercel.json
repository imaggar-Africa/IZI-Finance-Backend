{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install && npm install --prefix functions",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/cron).*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": [
        "functions/**",
        "node_modules/mongoose/**",
        "node_modules/mongodb/**",
        "node_modules/bson/**",
        "node_modules/kareem/**",
        "node_modules/mpath/**",
        "node_modules/mquery/**",
        "node_modules/sift/**",
        "node_modules/@mongodb-js/**",
        "node_modules/@fastify/busboy/**"
      ],
      "excludeFiles": [
        "node_modules/puppeteer/**",
        "node_modules/puppeteer-core/**",
        "node_modules/@puppeteer/**"
      ]
    },
    "api/cron/[job].js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "functions/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/loan-reminder",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/reconciliation",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/group-health",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/monthly-group-repayment",
      "schedule": "0 1 1 * *"
    },
    {
      "path": "/api/cron/credit-score-recovery",
      "schedule": "0 0 1 * *"
    }
  ]
}
