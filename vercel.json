{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install && npm install --prefix functions",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/cron).*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "{functions/**,functions/node_modules/**,node_modules/bcryptjs/**}",
      "excludeFiles": "node_modules/{puppeteer,puppeteer-core,@puppeteer}/**"
    },
    "api/cron/[job].js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "functions/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/loan-reminder",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/reconciliation",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/group-health",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/monthly-group-repayment",
      "schedule": "0 1 1 * *"
    },
    {
      "path": "/api/cron/credit-score-recovery",
      "schedule": "0 0 1 * *"
    }
  ]
}
