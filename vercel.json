{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install && node scripts/sync-vercel-api-deps.js && npm install --prefix api --omit=dev && node scripts/vercel-prune.js",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/cron).*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "{functions/**,api/node_modules/**}",
      "excludeFiles": "node_modules/{puppeteer,puppeteer-core,@puppeteer}/**"
    },
    "api/cron/[job].js": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "{functions/**,api/node_modules/**}",
      "excludeFiles": "node_modules/{puppeteer,puppeteer-core,@puppeteer}/**"
    },
    "api/admin/clear-sms-queue.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{functions/**,api/node_modules/**}",
      "excludeFiles": "node_modules/{puppeteer,puppeteer-core,@puppeteer}/**"
    }
  }
}
