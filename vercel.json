{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "izi-backend": {
      "root": ".",
      "installCommand": "npm install && npm install --prefix functions",
      "buildCommand": "",
      "functions": {
        "api/index.js": {
          "maxDuration": 300,
          "memory": 3008,
          "includeFiles": "functions/**"
        },
        "api/cron/[job].js": {
          "maxDuration": 300,
          "memory": 1024,
          "includeFiles": "functions/**"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/cron).*)",
      "destination": { "service": "izi-backend", "path": "/api" }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/loan-reminder",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/reconciliation",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/group-health",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/monthly-group-repayment",
      "schedule": "0 1 1 * *"
    },
    {
      "path": "/api/cron/credit-score-recovery",
      "schedule": "0 0 1 * *"
    }
  ]
}
